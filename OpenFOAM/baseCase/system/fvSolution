FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"   //specifies all values starting with rho eg rho1
    {
        solver          diagonal;
    }

    p_rgh       //dynamic pressure field in incompressible flows
    {
        solver          PCG;        //Preconditioned Conjugate Gradient (PCG) solver
        preconditioner  DIC;        //Diagonal Incomplete Cholesky (DIC) preconditioner
        tolerance       1e-8;
        relTol          0.01;
    }

    p_rghFinal      //dynamic pressure field in incompressible flows
    {
        $p_rgh;     //specifies to use the same settings as above
        relTol          0;
    }

    "(U|e)"     //got rid of |k|epsilon, velocity and energy
    {
        solver          PBiCGStab;       
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    "(U|e)Final"       //got rid of |k|epsilon, final velocity and final energy
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor yes;
    nOuterCorrectors 1;
    nCorrectors     2;      //number of inner pressure correction steps per iteration
    nNonOrthogonalCorrectors 0;

    pRefCell        0;
    pRefValue       0;      //sets reference pressure to 0
}

