FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;  //eConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       28.96;
    }
    equationOfState
    {
        rho0            1.225;
        T0              300;
        beta            0.0034;
    }
    thermodynamics
    {
        Cp              1004.9;
        hf              0;
    }
    transport
    {
        mu              0.00001831;  //1e-05;
        Pr              0.705;
    }
}


